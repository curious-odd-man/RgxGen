@startuml
title
""Pattern: `(b$)*`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_3
component """END""" as node_END_4

rectangle "Repeat: (b$)* 		 {0..<&infinity>}" {
  rectangle "Group 1: (b$)" {
    rectangle "Sequence: (b$)" {
      component """FinalSymbol(b)""" as node_AST_1
      component """AnchorNode($)""" as node_AST_2
    }
  }
  component """Repeat((b$)*)""" as node_REPEAT_ENTRY_0 <<repeat>>
}

node_AST_1 --> node_AST_2
node_REPEAT_ENTRY_0 --> node_AST_1 : 0..<&infinity>
node_AST_2 --> node_REPEAT_ENTRY_0
node_BEGIN_3 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_END_4
}
@enduml
