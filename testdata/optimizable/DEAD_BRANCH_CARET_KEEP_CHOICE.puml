@startuml
title
""Pattern: `c(b|^a|x)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_6
component """END""" as node_END_7

rectangle "Sequence: c(b|^a|x)" {
  rectangle "Group 1: (b|^a|x)" {
    rectangle "Choice: (b|^a|x)" {
      rectangle "Sequence: ^a|" {
        component """AnchorNode(^)""" as node_AST_3
        component """FinalSymbol(a)""" as node_AST_4
      }
      component """Choice((b|^a|x))""" as node_CHOICE_1 <<choice>>
      component """FinalSymbol(b)""" as node_AST_2
      component """FinalSymbol(x)""" as node_AST_5
    }
  }
  component """FinalSymbol(c)""" as node_AST_0
}

node_AST_3 --> node_AST_4
node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_CHOICE_1 --> node_AST_5
node_AST_0 --> node_CHOICE_1
node_BEGIN_6 --> node_AST_0
node_AST_2 --> node_END_7
node_AST_4 --> node_END_7
node_AST_5 --> node_END_7
}
@enduml
