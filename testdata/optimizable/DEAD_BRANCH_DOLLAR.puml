@startuml
title
""Pattern: `(a$|b)c`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Sequence: (a$|b)c" {
  rectangle "Group 1: (a$|b)" {
    rectangle "Choice: (a$|b)" {
      rectangle "Sequence: (a$|" {
        component """FinalSymbol(a)""" as node_AST_1
        component """AnchorNode($)""" as node_AST_2
      }
      component """Choice((a$|b))""" as node_CHOICE_0 <<choice>>
      component """FinalSymbol(b)""" as node_AST_3
    }
  }
  component """FinalSymbol(c)""" as node_AST_4
}

node_AST_1 --> node_AST_2
node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_AST_3
node_AST_2 --> node_AST_4
node_AST_3 --> node_AST_4
node_BEGIN_5 --> node_CHOICE_0
node_AST_4 --> node_END_6
}
@enduml
