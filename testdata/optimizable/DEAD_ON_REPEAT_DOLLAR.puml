@startuml
title
""Pattern: `(a$|x){1,2}`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Repeat: (a$|x){1,2} 		 {1..2}" {
  rectangle "Group 1: (a$|x)" {
    rectangle "Choice: (a$|x)" {
      rectangle "Sequence: (a$|" {
        component """FinalSymbol(a)""" as node_AST_2
        component """AnchorNode($)""" as node_AST_3
      }
      component """Choice((a$|x))""" as node_CHOICE_1 <<choice>>
      component """FinalSymbol(x)""" as node_AST_4
    }
  }
  component """Repeat((a$|x){1,2})""" as node_REPEAT_ENTRY_0 <<repeat>>
}

node_AST_2 --> node_AST_3
node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_4
node_REPEAT_ENTRY_0 --> node_CHOICE_1 : 1..2
node_AST_3 --> node_REPEAT_ENTRY_0
node_AST_4 --> node_REPEAT_ENTRY_0
node_BEGIN_5 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_END_6
}
@enduml
