@startuml
title
""Pattern: `(a$|b|x)c`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_6
component """END""" as node_END_7

rectangle "Sequence: (a$|b|x)c" {
  rectangle "Group 1: (a$|b|x)" {
    rectangle "Choice: (a$|b|x)" {
      rectangle "Sequence: (a$|" {
        component """FinalSymbol(a)""" as node_AST_1
        component """AnchorNode($)""" as node_AST_2
      }
      component """Choice((a$|b|x))""" as node_CHOICE_0 <<choice>>
      component """FinalSymbol(b)""" as node_AST_3
      component """FinalSymbol(x)""" as node_AST_4
    }
  }
  component """FinalSymbol(c)""" as node_AST_5
}

node_AST_1 --> node_AST_2
node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_AST_3
node_CHOICE_0 --> node_AST_4
node_AST_2 --> node_AST_5
node_AST_3 --> node_AST_5
node_AST_4 --> node_AST_5
node_BEGIN_6 --> node_CHOICE_0
node_AST_5 --> node_END_7
}
@enduml
