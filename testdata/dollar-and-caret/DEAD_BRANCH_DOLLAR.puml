@startuml
title
""Pattern: `(a$|b)c`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Sequence: (b)c" {
  rectangle "Group 1: (b)" {
    component """FinalSymbol(b)""" as node_AST_3
  }
  component """FinalSymbol(c)""" as node_AST_4
}

node_BEGIN_5 --> node_AST_3
node_AST_3 --> node_AST_4
node_AST_4 --> node_END_6
}
@enduml
