@startuml
title
""Pattern: `^(a|^b)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Sequence: ^(a|^b)" {
  rectangle "Group 1: (a|^b)" {
    rectangle "Choice: (a|^b)" {
      rectangle "Sequence: (a|^b)" {
        component """AnchorNode(^)""" as node_AST_3
        component """FinalSymbol(b)""" as node_AST_4
      }
      component """Choice((a|^b))""" as node_CHOICE_1 <<choice>>
      component """FinalSymbol(a)""" as node_AST_2
    }
  }
  component """AnchorNode(^)""" as node_AST_0
}

node_AST_3 --> node_AST_4
node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_AST_0 --> node_CHOICE_1
node_BEGIN_5 --> node_AST_0
node_AST_2 --> node_END_6
node_AST_4 --> node_END_6
}
@enduml
