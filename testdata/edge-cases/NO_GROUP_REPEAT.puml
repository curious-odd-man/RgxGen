@startuml
title
""Pattern: `^x+`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_3
component """END""" as node_END_4

rectangle "Sequence: ^x+" {
  rectangle "Repeat: x+ 		 {1..<&infinity>}" {
    component """Repeat(x+)""" as node_REPEAT_ENTRY_1 <<repeat>>
    component """FinalSymbol(x)""" as node_AST_2
  }
  component """AnchorNode(^)""" as node_AST_0
}

node_REPEAT_ENTRY_1 --> node_AST_2 : 1..<&infinity>
node_AST_2 --> node_REPEAT_ENTRY_1
node_AST_0 --> node_REPEAT_ENTRY_1
node_BEGIN_3 --> node_AST_0
node_REPEAT_ENTRY_1 --> node_END_4
}
@enduml
