@startuml
title
""Pattern: `(a|^x)+ --> (\1)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_7
component """END""" as node_END_8

rectangle "Sequence: (a|^x)+ --> (\1)" {
  rectangle "Repeat: (a|^x)+ 		 {1..<&infinity>}" {
    rectangle "Group 1: (a|^x)" {
      rectangle "Choice: (a|^x)" {
        rectangle "Sequence: (a|^x)" {
          component """AnchorNode(^)""" as node_AST_3
          component """FinalSymbol(x)""" as node_AST_4
        }
        component """Choice((a|^x))""" as node_CHOICE_1 <<choice>>
        component """FinalSymbol(a)""" as node_AST_2
      }
    }
    component """Repeat((a|^x)+)""" as node_REPEAT_ENTRY_0 <<repeat>>
  }
  rectangle "Group 2: (\1)" {
    component """GroupRef(\1)""" as node_AST_6
  }
  component """FinalSymbol( --> )""" as node_AST_5
}

node_AST_3 --> node_AST_4
node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_REPEAT_ENTRY_0 --> node_CHOICE_1 : 1..<&infinity>
node_AST_2 --> node_REPEAT_ENTRY_0
node_AST_4 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_AST_5
node_AST_5 --> node_AST_6
node_BEGIN_7 --> node_REPEAT_ENTRY_0
node_AST_6 --> node_END_8
}
@enduml
