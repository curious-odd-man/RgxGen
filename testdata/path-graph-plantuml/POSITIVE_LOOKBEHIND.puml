@startuml
title
""Pattern: `(?<=foo)bar`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_2
component """END""" as node_END_3

rectangle "Sequence: (?<=foo)bar" {
  component """FinalSymbol(foo)""" as node_AST_0
  component """FinalSymbol(bar)""" as node_AST_1
}

node_AST_0 --> node_AST_1
node_BEGIN_2 --> node_AST_0
node_AST_1 --> node_END_3
}
@enduml
