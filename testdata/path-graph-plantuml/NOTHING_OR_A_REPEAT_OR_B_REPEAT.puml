@startuml
title
""Pattern: `(|(a{1,2}|b{1,2}))`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_7
component """END""" as node_END_8

rectangle "Group 1: (|(a{1,2}|b{1,2}))" {
  rectangle "Choice: (|(a{1,2}|b{1,2}))" {
    rectangle "Group 2: (a{1,2}|b{1,2})" {
      rectangle "Choice: (a{1,2}|b{1,2})" {
        rectangle "Repeat: a{1,2} 		 {1..2}" {
          component """Repeat(a{1,2})""" as node_REPEAT_ENTRY_3 <<repeat>>
          component """FinalSymbol(a)""" as node_AST_4
        }
        rectangle "Repeat: b{1,2} 		 {1..2}" {
          component """Repeat(b{1,2})""" as node_REPEAT_ENTRY_5 <<repeat>>
          component """FinalSymbol(b)""" as node_AST_6
        }
        component """Choice((a{1,2}|b{1,2}))""" as node_CHOICE_2 <<choice>>
      }
    }
    component """Choice((|(a{1,2}|b{1,2})))""" as node_CHOICE_0 <<choice>>
    component """FinalSymbol()""" as node_AST_1
  }
}

node_REPEAT_ENTRY_3 --> node_AST_4 : 1..2
node_AST_4 --> node_REPEAT_ENTRY_3
node_REPEAT_ENTRY_5 --> node_AST_6 : 1..2
node_AST_6 --> node_REPEAT_ENTRY_5
node_CHOICE_2 --> node_REPEAT_ENTRY_3
node_CHOICE_2 --> node_REPEAT_ENTRY_5
node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_CHOICE_2
node_BEGIN_7 --> node_CHOICE_0
node_AST_1 --> node_END_8
node_REPEAT_ENTRY_3 --> node_END_8
node_REPEAT_ENTRY_5 --> node_END_8
}
@enduml
