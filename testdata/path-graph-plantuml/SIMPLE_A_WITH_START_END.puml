@startuml
title
""Pattern: `^a$`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_3
component """END""" as node_END_4

rectangle "Sequence: ^a$" {
  component """AnchorNode(^)""" as node_AST_0
  component """FinalSymbol(a)""" as node_AST_1
  component """AnchorNode($)""" as node_AST_2
}

node_AST_0 --> node_AST_1
node_AST_1 --> node_AST_2
node_BEGIN_3 --> node_AST_0
node_AST_2 --> node_END_4
}
@enduml
