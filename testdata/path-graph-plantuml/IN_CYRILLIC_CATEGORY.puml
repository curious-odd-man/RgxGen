@startuml
title
""Pattern: `\p{InCyrillic}{2}`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_2
component """END""" as node_END_3

rectangle "Repeat: \p{InCyrillic}{2} 		 {2..2}" {
  component """Repeat(\p{InCyrillic}{2})""" as node_REPEAT_ENTRY_0 <<repeat>>
  component """SymbolSet(\p{InCyrillic})""" as node_AST_1
}

node_REPEAT_ENTRY_0 --> node_AST_1 : 2
node_AST_1 --> node_REPEAT_ENTRY_0
node_BEGIN_2 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_END_3
}
@enduml
