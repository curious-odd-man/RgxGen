@startuml
title
""Pattern: `(a)(\1|b)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_4
component """END""" as node_END_5

rectangle "Sequence: (a)(\1|b)" {
  rectangle "Group 1: (a)" {
    component """FinalSymbol(a)""" as node_AST_0
  }
  rectangle "Group 2: (\1|b)" {
    rectangle "Choice: (\1|b)" {
      component """Choice((\1|b))""" as node_CHOICE_1 <<choice>>
      component """GroupRef(\1)""" as node_AST_2
      component """FinalSymbol(b)""" as node_AST_3
    }
  }
}

node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_AST_0 --> node_CHOICE_1
node_BEGIN_4 --> node_AST_0
node_AST_2 --> node_END_5
node_AST_3 --> node_END_5
}
@enduml
