@startuml
title
""Pattern: `(B||A)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_4
component """END""" as node_END_5

rectangle "Group 1: (B||A)" {
  rectangle "Choice: (B||A)" {
    component """Choice((B||A))""" as node_CHOICE_0 <<choice>>
    component """FinalSymbol(B)""" as node_AST_1
    component """FinalSymbol()""" as node_AST_2
    component """FinalSymbol(A)""" as node_AST_3
  }
}

node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_AST_2
node_CHOICE_0 --> node_AST_3
node_BEGIN_4 --> node_CHOICE_0
node_AST_1 --> node_END_5
node_AST_2 --> node_END_5
node_AST_3 --> node_END_5
}
@enduml
