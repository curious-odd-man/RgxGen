@startuml
title
""Pattern: `(a|b)\1{2,3}`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Sequence: (a|b)\1{2,3}" {
  rectangle "Group 1: (a|b)" {
    rectangle "Choice: (a|b)" {
      component """Choice((a|b))""" as node_CHOICE_0 <<choice>>
      component """FinalSymbol(a)""" as node_AST_1
      component """FinalSymbol(b)""" as node_AST_2
    }
  }
  rectangle "Repeat: \1{2,3} 		 {2..3}" {
    component """Repeat(\1{2,3})""" as node_REPEAT_ENTRY_3 <<repeat>>
    component """GroupRef(\1)""" as node_AST_4
  }
}

node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_AST_2
node_REPEAT_ENTRY_3 --> node_AST_4 : 2..3
node_AST_4 --> node_REPEAT_ENTRY_3
node_AST_1 --> node_REPEAT_ENTRY_3
node_AST_2 --> node_REPEAT_ENTRY_3
node_BEGIN_5 --> node_CHOICE_0
node_REPEAT_ENTRY_3 --> node_END_6
}
@enduml
