@startuml
title
""Pattern: `aa?`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_3
component """END""" as node_END_4

rectangle "Sequence: aa?" {
  rectangle "Repeat: a? 		 {0..1}" {
    component """Repeat(a?)""" as node_REPEAT_ENTRY_1 <<repeat>>
    component """FinalSymbol(a)""" as node_AST_2
  }
  component """FinalSymbol(a)""" as node_AST_0
}

node_REPEAT_ENTRY_1 --> node_AST_2 : 0..1
node_AST_2 --> node_REPEAT_ENTRY_1
node_AST_0 --> node_REPEAT_ENTRY_1
node_BEGIN_3 --> node_AST_0
node_REPEAT_ENTRY_1 --> node_END_4
}
@enduml
