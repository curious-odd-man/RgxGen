@startuml
title
""Pattern: `(a{0,2}|b{0,2})`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_5
component """END""" as node_END_6

rectangle "Group 1: (a{0,2}|b{0,2})" {
  rectangle "Choice: (a{0,2}|b{0,2})" {
    rectangle "Repeat: a{0,2} 		 {0..2}" {
      component """Repeat(a{0,2})""" as node_REPEAT_ENTRY_1 <<repeat>>
      component """FinalSymbol(a)""" as node_AST_2
    }
    rectangle "Repeat: b{0,2} 		 {0..2}" {
      component """Repeat(b{0,2})""" as node_REPEAT_ENTRY_3 <<repeat>>
      component """FinalSymbol(b)""" as node_AST_4
    }
    component """Choice((a{0,2}|b{0,2}))""" as node_CHOICE_0 <<choice>>
  }
}

node_REPEAT_ENTRY_1 --> node_AST_2 : 0..2
node_AST_2 --> node_REPEAT_ENTRY_1
node_REPEAT_ENTRY_3 --> node_AST_4 : 0..2
node_AST_4 --> node_REPEAT_ENTRY_3
node_CHOICE_0 --> node_REPEAT_ENTRY_1
node_CHOICE_0 --> node_REPEAT_ENTRY_3
node_BEGIN_5 --> node_CHOICE_0
node_REPEAT_ENTRY_1 --> node_END_6
node_REPEAT_ENTRY_3 --> node_END_6
}
@enduml
