@startuml
title
""Pattern: `c(a$|b)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_4
component """END""" as node_END_5

rectangle "Sequence: c(a$|b)" {
  rectangle "Group 1: (a$|b)" {
    rectangle "Choice: (a$|b)" {
      component """Choice((a$|b))""" as node_CHOICE_1 <<choice>>
      component """FinalSymbol(a) <:26d4:>""" as node_AST_2
      component """FinalSymbol(b) """ as node_AST_3
    }
  }
  component """FinalSymbol(c) """ as node_AST_0
}

node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_AST_0 --> node_CHOICE_1
node_BEGIN_4 --> node_AST_0
node_AST_2 --> node_END_5
node_AST_3 --> node_END_5
}
@enduml
