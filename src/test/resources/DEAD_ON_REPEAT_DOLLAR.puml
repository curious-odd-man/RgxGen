@startuml
title
""Pattern: `(a$|x){1,2}`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_4
component """END""" as node_END_5

rectangle "Repeat: (a$|x){1,2} 		 {1..2}" {
  rectangle "Group 1: (a$|x)" {
    rectangle "Choice: (a$|x)" {
      component """Choice((a$|x))""" as node_CHOICE_1 <<choice>>
      component """FinalSymbol(a) <:26d4:>""" as node_AST_2
      component """FinalSymbol(x) """ as node_AST_3
    }
  }
  component """Repeat((a$|x){1,2})""" as node_REPEAT_ENTRY_0 <<repeat>>
}

node_CHOICE_1 --> node_AST_2
node_CHOICE_1 --> node_AST_3
node_REPEAT_ENTRY_0 --> node_CHOICE_1 : 1..2
node_AST_2 --> node_END_5
node_AST_3 --> node_REPEAT_ENTRY_0
node_BEGIN_4 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_END_5
}
@enduml
