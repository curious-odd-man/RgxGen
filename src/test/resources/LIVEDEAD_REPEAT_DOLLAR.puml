@startuml
title
""Pattern: `(b$)*`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_2
component """END""" as node_END_3

rectangle "Repeat: (b$)* 		 {0..1}" {
  rectangle "Group 1: (b$)" {
    component """FinalSymbol(b) <:26d4:>""" as node_AST_1
  }
  component """Repeat((b$)*)""" as node_REPEAT_ENTRY_0 <<repeat>>
}

node_REPEAT_ENTRY_0 --> node_AST_1 : 0..1
node_AST_1 --> node_REPEAT_ENTRY_0
node_BEGIN_2 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_END_3
}
@enduml
