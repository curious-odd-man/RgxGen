@startuml
title
""Pattern: `(1$|1,){0,1}(2$|2,)`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_7
component """END""" as node_END_8

rectangle "Sequence: (1,){0,1}(2$|2,)" {
  rectangle "Repeat: (1,){0,1} 		 {0..1}" {
    rectangle "Group 1: (1,)" {
      component """FinalSymbol(1,) """ as node_AST_3
    }
    component """Repeat((1,){0,1})""" as node_REPEAT_ENTRY_0 <<repeat>>
  }
  rectangle "Group 2: (2$|2,)" {
    rectangle "Choice: (2$|2,)" {
      component """Choice((2$|2,))""" as node_CHOICE_4 <<choice>>
      component """FinalSymbol(2) <:26d4:>""" as node_AST_5
      component """FinalSymbol(2,) """ as node_AST_6
    }
  }
}

node_AST_3 --> node_REPEAT_ENTRY_0
node_CHOICE_4 --> node_AST_5
node_CHOICE_4 --> node_AST_6
node_REPEAT_ENTRY_0 --> node_CHOICE_4
node_BEGIN_7 --> node_REPEAT_ENTRY_0
node_REPEAT_ENTRY_0 --> node_AST_3
node_AST_5 --> node_END_8
node_AST_6 --> node_END_8
}
@enduml
