@startuml
title
""Pattern: `(^1|1,)(^2|2,){0,1}`""
end title

skinparam rectangle {
  BorderColor #888888
  BackgroundColor #F8F8FF
  FontStyle bold
}

component """BEGIN""" as node_BEGIN_7
component """END""" as node_END_8

rectangle "Sequence: (^1|1,)(2,){0,1}" {
  rectangle "Group 1: (^1|1,)" {
    rectangle "Choice: (^1|1,)" {
      component """Choice((^1|1,))""" as node_CHOICE_0 <<choice>>
      component """FinalSymbol(1) <:2693:>""" as node_AST_1
      component """FinalSymbol(1,) """ as node_AST_2
    }
  }
  rectangle "Repeat: (2,){0,1} 		 {0..1}" {
    rectangle "Group 2: (2,)" {
      component """FinalSymbol(2,) """ as node_AST_6
    }
    component """Repeat((2,){0,1})""" as node_REPEAT_ENTRY_3 <<repeat>>
  }
}

node_CHOICE_0 --> node_AST_1
node_CHOICE_0 --> node_AST_2
node_AST_6 --> node_REPEAT_ENTRY_3
node_AST_1 --> node_REPEAT_ENTRY_3
node_AST_2 --> node_REPEAT_ENTRY_3
node_BEGIN_7 --> node_CHOICE_0
node_REPEAT_ENTRY_3 --> node_AST_6
node_REPEAT_ENTRY_3 --> node_END_8
}
@enduml
